# OpenAI API Key (for LLM)
OPENAI_API_KEY=your-openai-api-key-here

# LightRAG API Configuration
LIGHTRAG_API_URL=https://your-lightrag-api-url/v1/query
LIGHTRAG_API_KEY=your-lightrag-api-key-here

# Email Service Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@ayefinance.com
SMTP_PASSWORD=your-app-password

# Database Configuration (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/hr_bot

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
